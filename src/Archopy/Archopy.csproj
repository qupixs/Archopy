<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Company>qupix</Company>
    <Copyright>Copyright © 2026 qupix</Copyright>
    <ApplicationIcon>Assets\Archopy.ico</ApplicationIcon>
    <AssemblyTitle>Archopy</AssemblyTitle>
    <Product>Archopy</Product>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\Archopy.png" />
    <None Update="Assets\Feather-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
