<Application x:Class="Archopy.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Archopy"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <Style x:Key="ResizeHandle" TargetType="Thumb">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
        <Grid Background="Transparent"><Path Data="M6 16 L16 6 M11 16 L16 11" Stroke="#FF888888" StrokeThickness="2"/></Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <SolidColorBrush x:Key="PillFill" Color="#202020"/>
    <SolidColorBrush x:Key="PillInk" Color="White"/>
    <ControlTemplate x:Key="Pill" TargetType="{x:Type ContentControl}">
      <local:PillSurface x:Name="Shell" Background="{DynamicResource PillFill}" Padding="{TemplateBinding Padding}">
        <ContentPresenter x:Name="Label" HorizontalAlignment="Center" VerticalAlignment="Center"
                          TextElement.Foreground="{DynamicResource PillInk}"/>
      </local:PillSurface>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Opacity" Value=".78"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="Opacity" Value=".68"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value=".40"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style TargetType="Button"><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template" Value="{StaticResource Pill}"/></Style>
    <Style x:Key="RailPart" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton">
        <Border Background="Transparent"><Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" VerticalAlignment="Center"/></Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Slider">
      <Setter Property="Height" Value="20"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
        <Grid Background="Transparent">
          <Track x:Name="PART_Track">
            <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Background="{DynamicResource PillInk}" Style="{StaticResource RailPart}"/></Track.DecreaseRepeatButton>
            <Track.Thumb><Thumb Width="10" Height="10" VerticalAlignment="Center"><Thumb.Template>
              <ControlTemplate TargetType="Thumb"><Ellipse Fill="{DynamicResource PillInk}"/></ControlTemplate>
            </Thumb.Template></Thumb></Track.Thumb>
            <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Background="#77888888" Style="{StaticResource RailPart}"/></Track.IncreaseRepeatButton>
          </Track>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <ControlTemplate x:Key="ChoicePill" TargetType="ToggleButton">
      <local:PillSurface x:Name="Shell" Background="{DynamicResource PillFill}" Padding="13,6">
        <ContentPresenter x:Name="Label" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource PillInk}"/>
      </local:PillSurface>
      <ControlTemplate.Triggers>
        <Trigger Property="IsChecked" Value="True">
          <Setter TargetName="Shell" Property="Background" Value="{DynamicResource PillInk}"/>
          <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource PillFill}"/>
        </Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Opacity" Value=".8"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="Opacity" Value=".68"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style TargetType="CheckBox"><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template" Value="{StaticResource ChoicePill}"/></Style>
    <Style TargetType="RadioButton">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Margin" Value="2"/><Setter Property="Template" Value="{StaticResource ChoicePill}"/>
    </Style>
    <Style TargetType="Expander">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
        <StackPanel>
          <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Content="{TemplateBinding Header}" HorizontalAlignment="Left">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
              <StackPanel Orientation="Horizontal" Background="Transparent">
                <local:FeatherIcon x:Name="Chevron" Glyph="down" RenderTransformOrigin=".5,.5" Margin="0,0,7,0"/>
                <ContentPresenter TextElement.Foreground="{DynamicResource PillInk}"/>
              </StackPanel>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter x:Name="Details" Visibility="Collapsed"/>
        </StackPanel>
        <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Details" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Application.Resources>
</Application>
